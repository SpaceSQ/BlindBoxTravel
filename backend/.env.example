# 大模型由开发公司 ROBOTZERO 提供，密钥只放在这台服务器上。
# 终端用户不填写 API。这里留空时，推荐仍用关键词匹配。
# OpenAI 兼容接口。
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 也兼容旧变量名。OPENAI_* 优先。
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# 和风天气。API Host 在控制台「设置」里，只写主机名，不要带 https://
# 例如 abcxyz.qweatherapi.com
# 详情会请求 /geo/v2/city/lookup、/v7/weather/3d，以及现行空气质量每日预报。
QWEATHER_API_KEY=
QWEATHER_API_HOST=

DATABASE_PATH=

# Sign in with Apple 的 audience，要和 iOS Bundle ID 一致。
APPLE_BUNDLE_ID=com.blindboxtravel.app

# Google OAuth 客户端 ID，逗号分隔。要和 App 里的 iOS / Android / Web client ID 一致。
GOOGLE_CLIENT_IDS=

# 仅本机 Debug 包使用。设为 1 时开放 POST /api/auth/dev。发布环境保持为空。
ALLOW_DEV_LOGIN=
